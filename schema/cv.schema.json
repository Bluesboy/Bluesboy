{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Bluesboy/Bluesboy/master/schema/cv.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["personal", "site", "target", "summary", "selected_work", "experience", "education", "languages", "skills", "about"],
  "properties": {
    "personal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["avatar", "full_name", "location", "business_travel", "email", "profiles"],
      "properties": {
        "avatar": { "type": "string" },
        "full_name": { "$ref": "#/$defs/i18nString" },
        "location": { "$ref": "#/$defs/location" },
        "business_travel": { "$ref": "#/$defs/i18nString" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profileItem" }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "work_format"],
      "properties": {
        "position": { "$ref": "#/$defs/i18nString" },
        "work_format": { "$ref": "#/$defs/i18nString" }
      }
    },
    "summary": { "$ref": "#/$defs/i18nStringArray" },
    "selected_work": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/selectedWorkItem" }
    },
    "experience": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/experienceItem" }
    },
    "education": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/educationItem" }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/languageItem" }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skillGroup" }
    },
    "about": { "$ref": "#/$defs/i18nStringArray" }
  },
  "$defs": {
    "i18nString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "ru": { "type": "string", "minLength": 1 }
      }
    },
    "i18nStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/i18nString" }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["city", "country_code"],
      "properties": {
        "city": { "$ref": "#/$defs/i18nString" },
        "country": { "$ref": "#/$defs/i18nString" },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "profileItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "url"],
      "properties": {
        "network": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "resume_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["en", "ru"] },
          "default": ["en", "ru"]
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      }
    },
    "achievementItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "ru"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "en": { "type": "string", "minLength": 1 },
        "ru": { "type": "string", "minLength": 1 },
        "featured": { "type": "boolean", "default": false }
      }
    },
    "skillItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "featured": { "type": "boolean", "default": false }
      }
    },
    "skillGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "items"],
      "properties": {
        "area": { "$ref": "#/$defs/i18nString" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/skillItem" } }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "end": { "type": ["string", "null"], "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" }
      }
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "selectedWorkItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["achievement_id", "title", "skill_ids"],
      "properties": {
        "achievement_id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/i18nString" },
        "skill_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "experienceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company", "location", "website", "period", "position", "detailed", "responsibilities", "achievements"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "company": { "$ref": "#/$defs/i18nString" },
        "resume_company": { "$ref": "#/$defs/i18nString" },
        "resume_group": { "$ref": "#/$defs/stableId" },
        "location": { "$ref": "#/$defs/location" },
        "remote": { "const": true },
        "website": { "type": "string", "format": "uri-reference" },
        "period": { "$ref": "#/$defs/period" },
        "position": { "$ref": "#/$defs/i18nString" },
        "detailed": { "type": "boolean" },
        "scope": { "$ref": "#/$defs/i18nString" },
        "responsibilities": { "$ref": "#/$defs/i18nStringArray" },
        "achievements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/achievementItem" } }
      }
    },
    "educationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institution", "year", "level", "specialization"],
      "properties": {
        "institution": { "$ref": "#/$defs/i18nString" },
        "year": { "type": "string", "pattern": "^\\d{4}$" },
        "level": { "$ref": "#/$defs/i18nString" },
        "specialization": { "$ref": "#/$defs/i18nString" }
      }
    },
    "languageItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "level"],
      "properties": {
        "language": { "$ref": "#/$defs/i18nString" },
        "level": { "$ref": "#/$defs/i18nString" }
      }
    }
  }
}
